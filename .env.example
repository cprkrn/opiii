# Easiest: run ./scripts/setup.sh and it writes .env for you.

# ---------- Required ----------
# Your iPhone number and/or Apple ID email, comma-separated. ONLY these get replies.
# (Include the email if your iPhone sends iMessages from it: Settings > Messages > Send & Receive.)
OWNER_NUMBER=+15551234567,you@icloud.com
# From `claude setup-token`: uses YOUR Claude subscription (valid ~1 year).
# Do NOT set ANTHROPIC_API_KEY (the server refuses to start if you do).
CLAUDE_CODE_OAUTH_TOKEN=

# ---------- iMessage provider ----------
# clawmessenger (default, ~$5/mo) | sendblue (~$100/mo) | console (local testing)
PROVIDER=clawmessenger
CLAW_API_KEY=

# Only for webhook providers (sendblue/console). Webhook URL = https://YOUR-HOST/webhook/<this>
# WEBHOOK_SECRET=a-long-random-string
# SENDBLUE_API_KEY_ID=
# SENDBLUE_API_SECRET_KEY=
# SENDBLUE_FROM_NUMBER=

# ---------- Model ----------
CLAUDE_MODEL=claude-opus-5-5

# ---------- Chat mode ----------
CLAUDE_TOOLS=WebSearch,WebFetch
CLAUDE_TIMEOUT_SECONDS=180
PERSONA_FILE=./persona.md

# ---------- Coding mode (/code) ----------
# GitHub token (fine-grained, only the repos you want) so it can clone/push/open PRs
GITHUB_TOKEN=
CLAUDE_CODE_TOOLS=default
# auto = a safety classifier approves each action. If your plan doesn't have
# auto mode, use bypassPermissions (it's sandboxed in the container anyway).
CLAUDE_CODE_PERMISSION_MODE=auto
CLAUDE_CODE_MAX_TURNS=80
CLAUDE_CODE_TIMEOUT_MINUTES=20

# ---------- Misc ----------
TZ=America/New_York
DATA_DIR=./data
PORT=3000
# LOG_WEBHOOKS=1   # print raw webhook bodies (handy when first connecting Sendblue)

# ---------- Speed ----------
CLAUDE_CHAT_EFFORT=low     # low = fastest replies; medium/high = more thorough
CLAUDE_CODE_EFFORT=high
DEBOUNCE_MS=1500           # merge texts sent within this window into one turn

# ---------- Friends (optional; never uses your Claude plan) ----------
# FRIENDS=+15551112222,+15553334444
# FRIENDS_API_BASE=https://openrouter.ai/api/v1
# FRIENDS_API_KEY=
# FRIENDS_MODEL=google/gemini-2.5-flash
# FRIENDS_DAILY_LIMIT=30
